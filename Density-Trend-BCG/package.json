{
  "name": "density-trend-bcg",
  "version": "1.0.0",
  "description": "Google News per-publication headline poll -> LLM impact reading -> density fields -> exposure map for BCG practice areas.",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --max-old-space-size=4096 src/cli.mjs run",
    "dev": "node --max-old-space-size=4096 src/dev.mjs --no-auto",
    "dev:auto": "node --max-old-space-size=4096 src/dev.mjs --schedule 480",
    "report": "node src/cli.mjs report",
    "test": "node --test \"test/*.test.mjs\""
  },
  "dependencies": {
    "pg": "^8.23.1"
  }
}
