# Caddy configuration for HiveMind Cloud Deployment
# Reverse proxy with automated TLS, zstd/gzip compression, and static asset caching

{
    email {$ACME_EMAIL:admin@example.com}
    admin off
}

{$DOMAIN:localhost} {
    encode zstd gzip

    # Static assets caching header for /ui/*
    @static path /ui/*
    header @static {
        Cache-Control "public, max-age=86400, stale-while-revalidate=604800"
        X-Content-Type-Options "nosniff"
    }

    # Reverse proxy to HiveMind Node.js app
    reverse_proxy app:8788 {
        header_up Host {host}
        header_up X-Real-IP {remote_host}
        header_up X-Forwarded-For {remote_host}
        header_up X-Forwarded-Proto {scheme}

        # Health checks
        health_uri /healthz
        health_interval 15s
        health_timeout 5s
    }
}
