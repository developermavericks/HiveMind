    "enabled": true
  },
  "sentiment": {
    "batchSize": 12
  },
  "seasonality": {
    "minDays": 28,
    "_note": "Weekday adjustment switches on once there are this many days of history."
  },
  "tuning": {
    "minOutcomes": 30,
    "minHits": 5,
    "step": 5,
    "_note": "Weights are only re-tuned from measured outcomes once there are enough of them."
  },
  "pricing": {
    "_note": "Optional: price per million tokens, to show an estimated spend. Leave empty to show tokens only.",
    "anthropic": {
      "inPerMTok": null,
      "outPerMTok": null
    }
  },
  "reading": {
    "mode": "headline",
    "_note": "Stories are read from the headline and snippet only (set HIVEMIND_FULLTEXT=1 to fetch article text again). This cuts model cost; the evidence rules therefore lean on independent origins, not on full-text share.",
    "batchSize": 4,
    "fullText": "after",
    "_fullTextNote": "\"after\": stories are first read from headlines (Claude), then the full-text job re-reads their articles with the low-cost model, keeping topic labels, to add detail. Measured: the low-cost model's own topic labels agreed only ~27-37% with Claude's, so it never assigns topics."
  },
  "topicMatch": {
    "maxTopics": 60,
    "refreshHours": 168,
    "batch": 6,
    "minRelevance": 0.3,
    "supportedRelevance": 0.5,
