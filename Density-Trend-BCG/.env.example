# Copy to .env (never commit .env). Only ANTHROPIC_API_KEY is required.
ANTHROPIC_API_KEY=
HIVEMIND_MODEL=claude-haiku-4-5
HIVEMIND_LLM=anthropic            # auto | anthropic | ollama

# Optional: collect automatically while `serve` is running. 480 = 3 times a day (the concept document's pilot polls hourly). Minimum 15.
HIVEMIND_SCHEDULE_MINUTES=480

# Optional: route Google News requests through a proxy if Google throttles you (Node 24+).
# NODE_USE_ENV_PROXY=1
# HTTPS_PROXY=http://user:pass@host:port

# Optional: search interest (Google Trends-style, relative 0-100) via SerpApi. Without it the panel says "unavailable".
# SERPAPI_KEY=

# Keep direct (non-proxy) traffic for the APIs below when the proxy is on
# NO_PROXY=api.anthropic.com,google.serper.dev,cloudfunctions.net,localhost,127.0.0.1
# Journalist directory endpoint (default is built in)
# JOURNALISTS_API_URL=
GROQ_API_KEY=            # cheap, fast open models (reads full articles); https://console.groq.com
GROQ_MODEL=llama-3.3-70b-versatile
