# Copy to .env (never commit .env). Docker Compose reads it too. No key is required to start the dashboard.
# Claude is OFF by default: switch it on in Settings -> Integrations if you want it (it needs ANTHROPIC_API_KEY).
# While it is off, Groq and OpenAI (GPT-5.6 Luna) do all the work and nothing can fall back to Claude.

# --- Models -------------------------------------------------------------------------------------------------------------
GROQ_API_KEY=                     # the low-cost workhorse; https://console.groq.com
GROQ_MODEL=openai/gpt-oss-120b
OPENAI_API_KEY=                   # GPT-5.6 Luna for the heavier jobs (reading headlines, matching, briefs, page layout); https://platform.openai.com
OPENAI_MODEL=gpt-5.6-luna
# ANTHROPIC_API_KEY=              # only used when Claude is switched on in Settings
# HIVEMIND_MODEL=claude-haiku-4-5
# HIVEMIND_LLM=auto               # auto | anthropic | ollama | off

# --- Collection ---------------------------------------------------------------------------------------------------------
# Collect automatically while `serve` runs. 480 = three times a day. Minimum 15. Left unset, nothing runs until someone presses a button.
# HIVEMIND_SCHEDULE_MINUTES=480
# In a container: HIVEMIND_AUTO=0 serves the dashboard only (default in docker-compose.yml); 1 turns scheduled collection on.
# HIVEMIND_AUTO=0

# --- Serving it to other people (containers and servers) ----------------------------------------------------------------
# HIVEMIND_ADMIN_EMAIL=you@example.com     # who may create the FIRST account. Set this on any server others can reach.
# HIVEMIND_ALLOWED_HOSTS=hivemind.example.com   # host names it answers to (localhost always works); needed behind a domain or proxy
# HIVEMIND_COOKIE_SECURE=1                 # when users reach it over https
# HIVEMIND_HOST=0.0.0.0                    # bind address (the image sets this; the default outside Docker is 127.0.0.1)
# PORT=8788

# --- Optional -----------------------------------------------------------------------------------------------------------
# A proxy is used for ONE thing: an article's text that could not be fetched directly is retried once through it. Google News polling, the model
# APIs and everything else connect directly. (NODE_USE_ENV_PROXY and NO_PROXY are no longer used: nothing is proxied globally.)
# HIVEMIND_BODY_PROXY=http://user:pass@host:port   # also read: DATAIMPULSE_PROXY_URL, then HTTPS_PROXY / HTTP_PROXY
# HIVEMIND_NO_PROXY=1                              # never use the proxy (the switch in Settings -> Integrations does the same)
# Certificate checking is switched back on at start-up even if the machine sets NODE_TLS_REJECT_UNAUTHORIZED=0.
# HIVEMIND_ALLOW_INSECURE_TLS=1                    # keep the machine's setting instead (only for a network that really needs it)
# SERPAPI_KEY=                    # search interest per topic; without it that panel says "unavailable"
